# Dockerfile.backend

# Stage 1 — Build
FROM rust:latest AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

COPY chat_server/Cargo.toml chat_server/Cargo.lock ./
RUN mkdir src && echo "fn main() {}" > src/main.rs
RUN cargo build --release
RUN rm -rf src

COPY chat_server/src ./src
COPY chat_server/migrations ./migrations
RUN touch src/main.rs
RUN cargo build --release

# Stage 2 — Runtime using same base as builder
FROM rust:latest

WORKDIR /app

COPY --from=builder /app/target/release/chat_server .
COPY --from=builder /app/migrations ./migrations

EXPOSE 8080 8081

CMD ["./chat_server"]